# Copy to .env.local and fill in. Never commit the filled file.

# --- Database ---------------------------------------------------------------
# Leave empty to use the local JSON store (.data/db.json) — fine for development,
# NEVER for a host that wipes its disk on deploy (Render, Vercel, Heroku).
MONGODB_URI=
MONGODB_DB=atelier_omar

# --- Admin account ----------------------------------------------------------
# Used by `npm run seed` to create the first administrator.
ADMIN_EMAIL=admin@atelier-omar.ma
ADMIN_PASSWORD=change-me-before-going-live

# --- Tokens -----------------------------------------------------------------
# 32+ random characters. The admin token is readable by the browser
# (localStorage), so this secret is the only thing protecting the back office.
AUTH_SECRET=

# --- Network ----------------------------------------------------------------
PORT=4400
# Comma-separated list of sites allowed to call this API. Without the real
# domain in here, the browser blocks every request from the live site.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4321

# Public base URL of this API, used to build absolute URLs for uploaded images.
PUBLIC_URL=http://localhost:4400
